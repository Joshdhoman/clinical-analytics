# Canonical site URL. Set this to the real domain in production — it is what
# metadataBase uses to build absolute Open Graph / X card image URLs.
# Without it, previews fall back to localhost and will not render for crawlers.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional override for the verified Streamlit app URL in lib/site.ts.
NEXT_PUBLIC_PLACEMENT_DEMO_URL=
